{
  "name": "uita-recursive-atc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 0.0.0.0 --port ${PORT:-5190} --strictPort",
    "build": "vite build && npm run build:overview",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.mjs",
    "build:overview": "npm run typecheck && vite build --config vite.overview.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "d3-geo": "3.1.1",
    "d3-polygon": "3.0.1",
    "lucide": "0.468.0",
    "three": "0.170.0",
    "three186": "npm:three@0.186.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three180": "npm:three@0.180.0"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "8.3.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
