# Defaults are credential-free offline fixture mode; never commit secrets.
DATABASE_URL=sqlite:///./uita.db
UITA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for remote mutation; configure reverse proxy/TLS separately.
UITA_API_TOKEN=
CRUSOE_API_KEY=
CRUSOE_MAX_SPEND_USD=0
