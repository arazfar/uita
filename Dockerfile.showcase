FROM node:22-bookworm-slim AS showcase
WORKDIR /app/showcase
COPY showcase/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY showcase/candidates ./candidates
RUN test -f candidates/app.html && test -f node_modules/three186/build/three.module.js && test -f node_modules/cesium/Build/Cesium/Cesium.js

FROM node:22-bookworm-slim AS workbench
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_RESEARCH_V2=true
RUN npm run build

FROM python:3.11-slim
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY backend/ ./backend/
COPY migrations/ ./migrations/
COPY alembic.ini ./
COPY benchmark/closed_loop/reports/2026-10-17/comparison.md ./benchmark/closed_loop/reports/2026-10-17/comparison.md
COPY --from=workbench /app/frontend/dist ./frontend/dist
COPY --from=showcase /app/showcase/candidates ./showcase/candidates
COPY --from=showcase /app/showcase/node_modules/three186 ./showcase/node_modules/three186
COPY --from=showcase /app/showcase/node_modules/cesium/Build/Cesium ./showcase/node_modules/cesium/Build/Cesium
RUN useradd --create-home uita
USER uita
ENV PYTHONPATH=/app/backend UITA_SHOWCASE=1 UITA_ACCESS_MODE=public_demo
EXPOSE 8001
CMD ["sh", "-c", "exec uvicorn uita.research.api:create_app --factory --host 0.0.0.0 --port ${PORT:-8001}"]
