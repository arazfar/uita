            "title": "Speed"
          },
          "runway": {
            "type": "string",
            "title": "Runway"
          },
          "scheduled": {
            "type": "number",
            "title": "Scheduled"
          },
          "requested": {
            "type": "number",
            "title": "Requested"
          },
          "delay": {
            "type": "number",
            "title": "Delay"
          },
          "emergency": {
            "type": "boolean",
            "title": "Emergency"
          },
