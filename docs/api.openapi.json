  "components": {
    "schemas": {
      "AgentEvent": {
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Sequence"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "message": {
            "type": "string",
            "maxLength": 400,
            "title": "Message"
          },
          "data": {
