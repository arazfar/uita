            "type": "object",
            "title": "Data"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "stage",
          "kind",
          "message",
          "created_at"
        ],
        "title": "AgentEvent"
      },
      "AgentLimits": {
        "properties": {
          "model_requests": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Model Requests",
            "default": 6
          },
          "tool_calls": {
            "type": "integer",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Tool Calls",
            "default": 12
          },
          "development_evaluations": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Development Evaluations",
            "default": 4
          },
          "revisions": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Revisions",
            "default": 1
          },
          "input_tokens": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1000.0,
            "title": "Input Tokens",
            "default": 60000
          },
          "output_tokens": {
            "type": "integer",
            "maximum": 12000.0,
            "minimum": 256.0,
            "title": "Output Tokens",
            "default": 6000
          },
          "request_output_tokens": {
            "type": "integer",
            "maximum": 1500.0,
            "minimum": 256.0,
            "title": "Request Output Tokens",
            "default": 1000
          },
          "wall_seconds": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 10.0,
            "title": "Wall Seconds",
            "default": 120
          },
          "spend_usd": {
            "type": "number",
            "maximum": 0.05,
            "exclusiveMinimum": 0.0,
            "title": "Spend Usd",
            "default": 0.02
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AgentLimits"
      },
      "AircraftView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "callsign": {
            "type": "string",
            "title": "Callsign"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "wake": {
            "type": "string",
            "title": "Wake"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "status": {
