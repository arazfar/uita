          },
          "speed": {
            "type": "number",
            "maximum": 30.0,
            "minimum": 0.25,
            "title": "Speed",
            "default": 1
          },
          "seed": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          },
          "scenario": {
            "type": "string",
            "title": "Scenario",
            "default": "baseline"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 8
              },
              {
                "type": "null"
              }
            ],
