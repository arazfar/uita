            "title": "Kind"
          },
          "runway": {
            "type": "string",
            "title": "Runway",
            "default": "28R"
          },
          "aircraft_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aircraft Id"
          },
          "severity": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Severity",
            "default": 1
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Disruption"
      },
