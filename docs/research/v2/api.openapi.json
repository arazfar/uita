  "components": {
    "schemas": {
      "AirportRulePack": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "effective_from": {
            "type": "string",
            "title": "Effective From"
          },
          "effective_until": {
            "type": "string",
            "title": "Effective Until"
          },
          "rules": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rules"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "effective_from",
          "effective_until",
          "rules",
          "limitations"
        ],
        "title": "AirportRulePack"
      },
      "Clearance": {
        "properties": {
          "aircraft_id": {
            "type": "string",
            "title": "Aircraft Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "heading",
              "altitude",
              "speed",
              "direct",
              "hold",
              "approach",
              "landing",
              "takeoff",
              "go_around",
              "handoff"
            ],
            "title": "Kind"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "aircraft_id",
          "kind"
        ],
        "title": "Clearance"
      },
      "Commit": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "idempotency_key",
          "proposal_id"
        ],
        "title": "Commit"
      },
      "Compare": {
        "properties": {
