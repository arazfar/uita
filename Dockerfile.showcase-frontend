FROM node:22-bookworm-slim AS overview-build
WORKDIR /app/showcase
COPY showcase/package*.json ./
RUN npm ci --no-audit --no-fund
COPY showcase/tsconfig.json showcase/vite.overview.config.ts ./
COPY showcase/src ./src
COPY showcase/candidates ./candidates
RUN npm run build:overview

FROM node:22-bookworm-slim
WORKDIR /app/showcase
COPY showcase/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY showcase/candidates ./candidates
COPY --from=overview-build /app/showcase/dist-overview/candidates ./candidates
COPY showcase/server.mjs ./server.mjs
ENV UITA_ACCESS_MODE=public_demo
USER node
CMD ["node", "server.mjs"]
